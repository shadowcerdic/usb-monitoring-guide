# rule: offhours_source_copy
# platform: Elastic Detection Engine — threshold rule (KQL)
# index: usb-monitoring (enriched)
# schedule: from now-26h, interval 1h
# threshold: field [user.name, host.name, event.date_utc], value 20
# MITRE: T1052 — Exfiltration over USB
# expected alert shape: one alert per user+host+UTC day when 20 source files
#   are copied outside 08:00-17:59
# caveats:
#   - event.hour_of_day and event.date_utc are UTC enrichment fields. Define
#     runtime fields or add them in enrichment; otherwise this rule matches
#     nothing.
#   - The 26h lookback covers the previous UTC day at the boundary.
#   - Change the 08/18 bounds and timezone decision together.
#   - Secondary Elastic translation; see appendix/elastic/README.md.
event.type: "creation"
  and file.drive_type: "removable"
  and usb.serial_number: *
  and file.extension_lower: (cs or java or py or go or ts)
  and (event.hour_of_day < 8 or event.hour_of_day >= 18)
